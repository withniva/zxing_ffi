#!/usr/bin/env ruby
# frozen_string_literal: true

# Regenerates committed test fixtures (dev only; outputs are committed).
#
#   mise exec -- bundle exec script/generate_fixtures             # every generator
#   mise exec -- bundle exec script/generate_fixtures symbologies  # only script/fixtures/symbologies.rb
#   mise exec -- bundle exec script/generate_fixtures --manifest   # only rebuild test/fixtures/manifest.yml
#
# Each generator in script/fixtures/<name>.rb writes its files under test/fixtures/ and, for corpus fixtures, a
# manifest fragment in test/fixtures/manifest.d/<name>.yml (a YAML list of entries). This driver then concatenates
# the fragments, sorted by file name, into test/fixtures/manifest.yml.

require "yaml"

ROOT = File.expand_path("..", __dir__)
GENERATORS = File.join(ROOT, "script", "fixtures")
FRAGMENTS = File.join(ROOT, "test", "fixtures", "manifest.d")
MANIFEST = File.join(ROOT, "test", "fixtures", "manifest.yml")

def build_manifest
  entries = Dir[File.join(FRAGMENTS, "*.yml")].sort.flat_map do |fragment|
    Array(YAML.safe_load_file(fragment, permitted_classes: [Symbol], aliases: true))
  end
  files = entries.map { |e| e["file"] }
  duplicates = files.tally.select { |_, n| n > 1 }.keys
  abort "Duplicate manifest entries: #{duplicates.join(", ")}" if duplicates.any?

  header = <<~YAML
    # GENERATED by script/generate_fixtures from test/fixtures/manifest.d/*.yml — edit the fragments instead.
    # Schema: see test/fixtures/README.md
  YAML
  File.write(MANIFEST, header + YAML.dump(entries))
  puts "Wrote #{MANIFEST} (#{entries.size} entries)"
end

manifest_only = ARGV.delete("--manifest")
unless manifest_only
  names = ARGV.empty? ? Dir[File.join(GENERATORS, "*.rb")].sort.map { |f| File.basename(f, ".rb") } : ARGV
  names.each do |name|
    path = File.join(GENERATORS, "#{name}.rb")
    abort "No generator #{path}" unless File.exist?(path)
    puts "== #{name}"
    system(RbConfig.ruby, path, exception: true)
  end
end
build_manifest
