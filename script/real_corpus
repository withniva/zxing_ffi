#!/usr/bin/env ruby
# frozen_string_literal: true

# Builds a LOCAL, never-committed corpus of real documents for regression runs.
#
#   mise exec -- bundle exec script/real_corpus
#   REAL_CORPUS_LIST=/path/to/list.yml mise exec -- bundle exec script/real_corpus
#
# Real documents contain personal data, so they must not live in this repository, and neither does the list of which
# ones to use: it is read from real_corpus.local.yml in the repository root (gitignored) or from REAL_CORPUS_LIST.
#
#   source: ~/path/to/documents   # the paths below are relative to it (a relative source: to the list's directory)
#   documents:                    # relative path => note; small files (≤ ~1 MB)
#     scans/document_a.pdf: "QR code on both pages"
#     scans/document_b.pdf: "no barcodes: dense tables"
#
# This script copies them into tmp/real_corpus/ (gitignored) and writes tmp/real_corpus/manifest.yml. When that
# manifest exists, test/corpus/manifest_test.rb and `rake bench` include it automatically; elsewhere (CI, other
# machines) the real corpus is simply absent. Decoded texts are stored only as SHA-256 even in the local manifest.
#
# There is no independent ground truth for real scans: expectations are what zxing_ffi decodes at :thorough with
# stop: :exhaustive (checked by hand to be plausible), and `effort` is the lowest level that finds them all.

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)
root = File.expand_path("..", __dir__)
ENV["ZXING_LIB"] ||= %w[libZXing.dylib libZXing.so].map { |n| File.join(root, "vendor/zxing/lib", n) }.find { |p| File.exist?(p) }

require "digest"
require "fileutils"
require "yaml"
require "zxing_ffi"

LIST = File.expand_path(ENV.fetch("REAL_CORPUS_LIST", File.join(root, "real_corpus.local.yml")))
TARGET = File.join(root, "tmp", "real_corpus")
MANIFEST = File.join(TARGET, "manifest.yml")

EFFORTS = %i[fast normal thorough].freeze

def signature(barcodes)
  barcodes.map { |b| [b.page, b.format, Digest::SHA256.hexdigest(b.text)] }.tally
end

abort "#{LIST} not found: write the document list there (format: script/real_corpus) or set REAL_CORPUS_LIST" unless File.exist?(LIST)
list = YAML.safe_load_file(LIST)
unless list.is_a?(Hash) && list["source"].is_a?(String) && list["documents"].is_a?(Hash)
  abort "#{LIST} needs a `source` directory and a `documents` mapping (format: script/real_corpus)"
end
source_dir = File.expand_path(list["source"], File.dirname(LIST))
abort "#{source_dir} not found (`source` in #{LIST})" unless Dir.exist?(source_dir)

entries = list["documents"].filter_map do |relative, notes|
  source = File.join(source_dir, relative)
  next warn("skipping missing #{source}") unless File.exist?(source)

  target = File.join(TARGET, relative)
  FileUtils.mkdir_p(File.dirname(target))
  FileUtils.cp(source, target)

  thorough = ZXingFFI.scan(target, effort: :thorough, stop: :exhaustive)
  wanted = signature(thorough)
  effort = EFFORTS.find { |e| signature(ZXingFFI.scan(target, effort: e, stop: :exhaustive)) == wanted } || :thorough
  kind = ZXingFFI::Sniffer.sniff(target)

  expected = thorough.map do |barcode|
    center = (kind == :pdf) ? barcode.page_position.center : barcode.center
    {
      "format" => barcode.format.to_s,
      "text_sha256" => Digest::SHA256.hexdigest(barcode.text),
      "page" => barcode.page,
      "center" => [center.x.round(1), center.y.round(1)],
      "tolerance" => 10,
      "rotation" => barcode.rotation
    }
  end
  puts format("%-36s %2d codes, effort %s", relative, expected.size, effort)
  {
    "file" => relative, "category" => "real", "kind" => kind.to_s, "requires" => [], "effort" => effort.to_s,
    "options" => {}, "expect_error" => nil, "expected" => expected,
    "notes" => "#{notes}. Local regression expectations recorded from zxing_ffi (texts as SHA-256)."
  }
end

header = <<~YAML
  # LOCAL ONLY - generated by script/real_corpus under tmp/ (gitignored). Never commit real documents or this file.
  # File paths are relative to this directory; decoded texts are identified by text_sha256.
YAML
File.write(MANIFEST, header + YAML.dump(entries))
puts "wrote #{MANIFEST} (#{entries.size} entries)"
